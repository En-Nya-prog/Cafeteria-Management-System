# Local development. Keep real credentials in the ignored .env file.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Required. Set this to the complete connection string for your development database.
# Local example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/ebd_inventory
DATABASE_URL=

# Production uses a restricted DATABASE_URL role. Use these only on the migration machine.
# DATABASE_MIGRATION_URL=
# DATABASE_RUNTIME_ROLE=
# DATABASE_CA_CERT=

# Staff MFA is required in production. Use a persistent 32-byte key encoded as 64 hex characters.
# STAFF_MFA_KEY=
# Verified Google Buyer accounts are required by default in production.
# REQUIRE_VERIFIED_BUYERS=

# Optional Google OAuth web client credentials.
# Add http://localhost:3000/api/auth/google/callback to the client's authorized redirect URIs.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional. Set a Paystack test secret to test checkout.
PAYSTACK_MODE=test
# PAYSTACK_SECRET_KEY=

# Optional. Set a Vercel Blob token to test meal image uploads.
# BLOB_READ_WRITE_TOKEN=

# Optional local storage paths.
# PRODUCTS_CSV_PATH=./products.csv
# UPLOADS_DIR=./uploads

# Optional meal announcement email settings.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
