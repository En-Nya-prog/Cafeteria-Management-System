# Local development only. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ebd_inventory
APP_BASE_URL=http://localhost:3000
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_test_secret
PAYSTACK_MODE=test
EBD_ADMIN_EMAIL=admin@example.com
EBD_ADMIN_PASSWORD=replace-with-a-unique-password
BLOB_READ_WRITE_TOKEN=replace-with-your-vercel-blob-token

# Optional local/Render persistent storage paths.
PRODUCTS_CSV_PATH=./products.csv
UPLOADS_DIR=./uploads
